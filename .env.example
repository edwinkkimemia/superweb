# SuperWeb — environment
PORT=3000
SITE_URL=https://superweb.co.ke
DATABASE_URL=postgres://postgres:postgres@localhost:5432/superweb
# Admin login (email + password for /admin). Leave both empty for open dev mode.
ADMIN_EMAIL=admin@superweb.co.ke
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Session secret that locks /admin pages + APIs. Leave empty for open dev mode.
ADMIN_TOKEN=change-me-to-a-long-random-secret
CONTACT_TO=info@superweb.co.ke
